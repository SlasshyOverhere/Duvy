# Crash reports. Leave empty and no build ever sends one; the user is only asked
# when the value is set. Copy to .env, or export it before `bun run tauri build`.
VITE_SENTRY_DSN=

# Anonymous usage counts (PostHog project key, a public write-only ingest key).
# Leave empty and nothing is ever counted; the user's Privacy switch is ignored
# in that case because there is nowhere to send to.
VITE_POSTHOG_KEY=
# EU cloud: https://eu.i.posthog.com
VITE_POSTHOG_HOST=
