{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-resize-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    },
    "dialog:allow-open",
    "dialog:allow-message",
    "allow-app-info",
    "allow-net-stats",
    "allow-playback-log",
    "allow-settings-get",
    "allow-settings-set",
    "allow-update-check",
    "allow-update-cached",
    "allow-update-install",
    "allow-addons-list",
    "allow-addons-install",
    "allow-addons-remove",
    "allow-addons-set-enabled",
    "allow-addons-move",
    "allow-addons-refresh",
    "allow-home-feed",
    "allow-catalog",
    "allow-search",
    "allow-meta-details",
    "allow-person-details",
    "allow-cast-photos",
    "allow-recommendations",
    "allow-similar",
    "allow-streams",
    "allow-subtitles",
    "allow-parental-guide",
    "allow-library-list",
    "allow-library-toggle",
    "allow-progress-list",
    "allow-progress-for",
    "allow-progress-clear",
    "allow-watched-set",
    "allow-watched-list",
    "allow-watched-marks",
    "allow-watched-keys",
    "allow-player-open",
    "allow-player-state",
    "allow-player-frame",
    "allow-player-control",
    "allow-player-stop",
    "allow-player-subtitle",
    "allow-window-fullscreen",
    "allow-nuvio-status",
    "allow-nuvio-sign-in",
    "allow-nuvio-sign-out",
    "allow-nuvio-set-profile",
    "allow-nuvio-profiles",
    "allow-nuvio-sync-now",
    "allow-stremio-status",
    "allow-stremio-sign-in",
    "allow-stremio-sign-out",
    "allow-stremio-sync-now",
    "allow-sync-all",
    "allow-scrobble",
    "allow-check-cache",
    "allow-skip-get",
    "allow-skip-lookup",
    "allow-skip-set",
    "allow-srv-list",
    "allow-srv-add",
    "allow-srv-remove",
    "allow-srv-items",
    "allow-srv-stream",
    "allow-status",
    "allow-begin",
    "allow-poll",
    "allow-disconnect",
    "allow-sync",
    "allow-providers",
    "allow-set-key",
    "allow-resolve"
  ]
}
